# Application Configuration
APP_NAME=Warpspeed Mini-ERP
APP_ENV=development
SECRET_KEY=warpspeed-super-secret-key-change-in-production-2026
SESSION_COOKIE_NAME=warpspeed_session

# Database Connection:
# 1. Local SQLite (Fast local testing without Docker/Postgres):
DATABASE_URL=sqlite:///./warpspeed_fastapi.db

# 2. Local Docker PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/warpspeed

# 3. Neon Serverless PostgreSQL:
# DATABASE_URL=postgresql://[user]:[password]@[endpoint].neon.tech/warpspeed?sslmode=require

# Manufacturing Constants
ROLL_LENGTH_M=50.0
WASTAGE_RATE=0.08
WAGE_RATE_PER_HOUR=120.0
OVERHEAD_RATE_PER_HOUR=50.0
